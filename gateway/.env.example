# ===== Gateway da Celula R-01: CLP -> MQTT =====

# CLP: o IP do S7 na rede.
#
# PORTA 503, nao 502: a 502 e da BALANCA e fica exclusiva dela. Com as duas
# instancias MB_SERVER na mesma porta, o gateway poderia ocupar as duas vagas
# numa reconexao e derrubar a balanca. Porta separada = vaga reservada.
#
# PLC_UNIT nao importa em Modbus TCP — o MB_SERVER da Siemens nao filtra por
# Unit ID (conferido no DB de instancia do projeto). Deixe 1.
PLC_IP=192.168.0.10
PLC_PORT=503
PLC_UNIT=1

# Broker MQTT. A credencial vai SEPARADA da URL de proposito: senha com
# @ : / # nao sobrevive dentro de uma URL.
#
# O host abaixo e o cluster HiveMQ da celula — ja preenchido, nao mexer.
MQTT_URL=mqtts://9dd637379bc94f2b89b23b6ec264fd19.s1.eu.hivemq.cloud:8883
MQTT_USER=celula-r01
MQTT_PASS=
MQTT_TOPICO=multilaser/paletizadora/r01/estado

# ===== BROKER LOCAL (opcional) — e' quem alimenta o SYNC =====
#
# Cliente SEPARADO do de cima, de proposito: sao redes com disponibilidade
# diferente. Internet caindo nao pode calar o SYNC, e o broker interno fora
# do ar nao pode calar o supervisorio 3D.
#
# DEIXAR VAZIO desliga: o gateway se comporta exatamente como antes.
#
# E' o mesmo broker que o SYNC ja' assina para a LO06 (secao MqttConfigs do
# appsettings.json: 10.1.5.10:1883, usuario atlas_mqtt).
MQTT2_URL=mqtt://10.1.5.10:1883
MQTT2_USER=atlas_mqtt
MQTT2_PASS=

# Base dos topicos, na gramatica que o SYNC ja' usa (`multi/linha/{LINHA}/...`
# para as linhas). A celula entra como `multi/celula/{CELULA}/...`:
#   <base>/estado   retido, QoS 0, o retrato da celula
#   <base>/online   retido, QoS 1, com Last Will
MQTT2_TOPICO_BASE=multi/celula/VENTILADOR
